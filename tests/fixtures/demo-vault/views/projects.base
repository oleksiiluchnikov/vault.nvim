filters:
  and:
    - file.hasTag("project")
    - file.inFolder("Project")

formulas:
  display_status: 'if(status, status, "unknown")'
  name_upper: "file.name.title()"

properties:
  file.name:
    displayName: "Name"
  status:
    displayName: "Status"
  formula.display_status:
    displayName: "Display Status"
  formula.name_upper:
    displayName: "Name (Title)"

views:
  - type: table
    name: "Project Table"
    order:
      - file.name
      - status
      - formula.display_status
      - formula.name_upper
    group_by: status
  - type: table
    name: "Simple List"
    order:
      - file.name
      - file.folder
  - type: kanban
    name: "Project Board"
    group_by: status
    group_values:
      - active
      - planned
      - done
      - on-hold
    display_fields:
      - file.name
      - tags
